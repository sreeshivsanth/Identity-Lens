# IdentityLens Backend Environment Configuration (Template)
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Dedicated GPU & Hardware Optimization
USE_GPU=True
CUDA_DEVICE=cuda:0
CUDA_VISIBLE_DEVICES=0
NVIDIA_VISIBLE_DEVICES=all
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Authentication & Superadmin Credentials (Configure your own secure values)
ADMIN_ROOT_USERNAME=admin@identitylens.local
ADMIN_ROOT_PASSWORD=ChangeMeSecurely123!
ADMIN_EMAILS=admin@identitylens.local
ADMIN_JWT_SECRET=identitylens-secure-jwt-hmac-secret-change-me
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# External API Integrations (Optional)
HIBP_API_KEY=
DEHASHED_API_KEY=
CAPSOLVER_API_KEY=
PERSPECTIVE_API_KEY=
